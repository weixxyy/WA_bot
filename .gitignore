# ======================
# Виртуальное окружение
# ======================
.venv/
venv/

# ==============
# Python
# ==============
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# ==================================
# Профили браузера (Firefox)
# ==================================
# ВНИМАНИЕ: внутри cookies.sqlite / key4.db / storage лежит сессия
# WhatsApp Web (wa_web_access_token, wa_ul) — это фактически доступ
# к аккаунту, поэтому эти каталоги НИКОГДА не должны попадать в git.
#
# Исключаем содержимое каталога, а не сам каталог: так в репозитории
# остаётся только заглушка profiles/.gitkeep, и папка profiles/ появляется
# у человека сразу после клонирования проекта.
profiles/*
!profiles/.gitkeep
whatsapp_profile/

# ======================
# Логи и отладка бота
# ======================
logs/
artifacts/
test-results/

# ==========================
# Конфигурация бота (личное)
# ==========================
# Ссылки-приглашения и текст отправляемого сообщения: в git попадают только
# шаблоны, чтобы у человека после клонирования были файлы-образцы.
urls.txt
send_to.txt
# Списки-сортировка скрипта вступления (join_groups.py): заполняются самим
# прогоном, в git не нужны.
only_admins_groups.txt
closed_groups.txt
open_groups.txt
# Настройки панели (расписание запусков): в git попадает только settings.json.example.
settings.json

# ==============
# IDE
# ==============
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
